# ── Mode ─────────────────────────────────────────────────────────────────────
# BACKTEST | PAPER | LIVE   (default PAPER; BACKTEST is used by the CLI tools)
MODE=PAPER
# Second, independent safety flag: LIVE orders are sent ONLY when MODE=LIVE
# AND this is true. Keep false until the event study + paper phase prove edge.
ENABLE_LIVE_TRADING=false

# ── Signal source & strategy ─────────────────────────────────────────────────
# TELEGRAM (default, free) | X | BOTH
SIGNAL_SOURCE=TELEGRAM
# SHORT_ONLY (default): never enter the pump; fade the confirmed reversal only.
# LONG_SHORT: original ride-the-pump-then-fade flow (needs low-latency source).
STRATEGY_MODE=SHORT_ONLY

# ── Telegram SOURCE (your own account, free — https://my.telegram.org) ───────
# One-time: python -m src.telegram_source.login  → paste TELEGRAM_SESSION below.
# Only channels you have JOINED with this account, comma separated.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TG_SOURCE_CHANNELS=
TG_MAX_MESSAGE_AGE_SECONDS=90

# SHORT_ONLY gates: a real pump must print before we even look for a reversal
MIN_PUMP_PERCENT=1.5
PUMP_WATCH_WINDOW_SECONDS=900

# ── X / Twitter (only if SIGNAL_SOURCE includes X) ───────────────────────────
# Bearer token. NOTE: Filtered Stream requires a paid tier that includes
# streaming (Pro). On Basic, the bot automatically falls back to timeline
# polling (higher latency — measured and logged per tweet).
X_BEARER_TOKEN=
X_TARGET_USERNAME=eliz883
# Force listener mode: auto | stream | poll
X_LISTENER_MODE=auto
X_POLL_INTERVAL_SECONDS=8

# ── Binance USDS-M Futures ───────────────────────────────────────────────────
# LIVE: keys from binance.com — enable ONLY "Futures" permission.
#       NEVER enable withdrawals. Use IP whitelist.
# PAPER against real market data needs no keys at all.
# Futures TESTNET (https://testnet.binancefuture.com) keys also work: set
# BINANCE_FUTURES_TESTNET=true to route all signed calls there.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_TESTNET=false

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional LLM classifier (ambiguous tweets only; failure => NO TRADE) ────
ANTHROPIC_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite by default; drop in a postgres URL to switch:
# postgresql+asyncpg://user:pass@host:5432/elizbot
DATABASE_URL=sqlite+aiosqlite:///data/elizbot.db

# ── Risk (conservative defaults for ~500 USDT capital) ───────────────────────
ACCOUNT_CAPITAL=500
MAX_RISK_PER_TRADE_USDT=5
MAX_DAILY_LOSS_USDT=25
MAX_POSITION_NOTIONAL_USDT=100
MAX_LEVERAGE=2
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3

# ── Signal / market filters ──────────────────────────────────────────────────
MAX_TWEET_AGE_SECONDS=45
MAX_CHASE_PERCENT=1.5
MAX_SPREAD_PERCENT=0.10
MIN_24H_VOLUME=20000000
MIN_ORDERBOOK_LIQUIDITY=30000
MIN_CONFIDENCE=0.55
TRADE_EARLY_SIGNALS=false

# ── Reversal / short ─────────────────────────────────────────────────────────
MIN_REVERSAL_SCORE=65
SHORT_CONFIRMATION_SECONDS=5
MAX_SHORT_HOLDING_SECONDS=900
LOG_LEVEL=INFO
