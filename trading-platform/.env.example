# ── Database / cache (required) ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://quantlab:quantlab@localhost:5432/quantlab
REDIS_URL=redis://localhost:6379/0

# ── Binance production (OPTIONAL, READ-ONLY account info only) ───────────────
# Create these keys READ-ONLY. Never grant trading. NEVER grant withdrawals.
# Enable IP whitelisting. Public market data needs no key at all.
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=

# ── Binance Spot TESTNET (optional; enables testnet execution) ───────────────
# Keys from https://testnet.binance.vision — trading permission is fine there.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ── Telegram (optional; enables control bot + notifications) ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GitHub (optional; raises rate limit for the GitHub collector) ────────────
GITHUB_TOKEN=

# ── Optional external providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# PAPER_ONLY or TESTNET_ACTIVE (testnet also requires testnet keys)
EXECUTION_MODE=PAPER_ONLY
